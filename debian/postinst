#!/bin/sh
# Post-installation: ensure yt-dlp is available (mirrors the runtime
# auto-install behavior in yttranscript/ytdlp.py so the package works
# even on systems where python3-yt-dlp is not packaged / is outdated).

set -e

case "$1" in
    configure)
        if ! command -v yt-dlp >/dev/null 2>&1; then
            echo "yttranscript: yt-dlp not found, installing via pip..." >&2
            python3 -m pip install --break-system-packages yt-dlp || \
                echo "yttranscript: WARNING: could not install yt-dlp; the tool will retry on first run." >&2
        fi
        if ! command -v typst >/dev/null 2>&1; then
            echo "yttranscript: NOTE: 'typst' not found; PDF/EPUB/DOCX export will be unavailable." >&2
            echo "yttranscript:       install via 'apt install typst' (Debian 13 trixie+ only) or" >&2
            echo "yttranscript:       download the static binary from https://github.com/typst/typst/releases" >&2
        fi
        if ! command -v himalaya >/dev/null 2>&1; then
            echo "yttranscript: NOTE: 'himalaya' not found; --email will be unavailable." >&2
            echo "yttranscript:       install via 'apt install himalaya' (Debian 13 trixie+ only) or" >&2
            echo "yttranscript:       download the static binary from https://github.com/pimalaya/himalaya/releases" >&2
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
